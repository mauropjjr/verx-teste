# Copie para .env e ajuste se necessário. Todos os valores abaixo são defaults de desenvolvimento local.

# PostgreSQL
POSTGRES_USER=banco
POSTGRES_PASSWORD=banco_dev
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=banco
RABBITMQ_PASSWORD=banco_dev
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Identidade (porta publicada e senhas dos usuários de demonstração)
IDENTIDADE_PORT=5000
IDENTIDADE_SENHA_CONSULTA=Consulta@123
IDENTIDADE_SENHA_OPERADOR=Operador@123
IDENTIDADE_SENHA_ADMIN=Admin@123

# Lançamentos (porta publicada)
LANCAMENTOS_PORT=5001
# Seed de ~1 ano de lançamentos nas contas demo na primeira subida (false desliga)
SEMEADURA_HISTORICO_HABILITADO=true

# Consolidado (porta publicada da Api)
CONSOLIDADO_PORT=5002

# Portal web (porta publicada) e cookie de sessão com Secure (true atrás de HTTPS; false em http://localhost)
WEB_PORT=3000
COOKIE_SEGURO=false
